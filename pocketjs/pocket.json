{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.iamcheyan.heya-pocketjs",
  "name": "heya-pocketjs",
  "title": "heya PocketJS Prototype",
  "version": "0.1.0",
  "engine": { "capabilities": { "requires": ["text.glyphs.baked", "input.buttons"] } },
  "app": {
    "entry": "heya-pocket-main.tsx",
    "output": "heya-pocket-main",
    "framework": "solid",
    "viewport": { "fixed": { "logical": [720, 480], "presentation": "integer-fit" } }
  }
}
